# Normalize line endings on checkout/commit.
* text=auto eol=lf

# Keep the Composer dist lean: exclude dev-only paths from package archives.
# Source, config, database stubs, README, LICENSE, CHANGELOG and composer.json ship.
/.github               export-ignore
/docs                  export-ignore
/tests                 export-ignore
/.editorconfig         export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
/.gitguardian.yaml     export-ignore
/.gitleaks.toml        export-ignore
/CONTRIBUTING.md       export-ignore
/SECURITY.md           export-ignore
/infection.json5       export-ignore
/phpstan.neon          export-ignore
/phpunit.xml           export-ignore
/rector.php            export-ignore
