includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Strictest level, no baseline. An ignore needs a comment saying why.
    level: max
    # src only, as across the family: Larastan reads a package's own config/ file as if it sat
    # outside the application's config directory and flags its env() calls, which is wrong.
    paths:
        - src
        # PHPStan analyses a trait only where a class uses it; this fixture model uses
        # HasSettings, so the trait is checked in context.
        - tests/Fixtures/SettingsOwner.php
    treatPhpDocTypesAsCertain: false
