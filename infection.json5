{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        // Service providers are framework wiring: their surviving mutants are registration
        // calls whose effect the feature suite proves end to end.
        "excludes": [
            "Providers"
        ]
    },
    "mutators": {
        "@default": true
    },
    // Infection has no Pest framework key, so it drives Pest through the PHPUnit adapter,
    // pointed at Pest's own binary: Pest's PHPUnit shim refuses to run Pest test files
    // directly, which failed the initial test run (same fix as laranail/toolkit).
    "testFramework": "phpunit",
    "phpUnit": {
        "customPath": "vendor/bin/pest"
    },
    // Infection reads Pest's version (4.x) as a PHPUnit version and writes a legacy <filter>
    // element into its generated config. PHPUnit 12 reports that as a PHPUnit warning
    // (invalid configuration), which fails the run with exit 1 although every test passes;
    // `--do-not-fail-on-warning` does not cover it. Only Infection's runs relax this; the main
    // suite still fails on any warning. Reproduced locally: exit 1 without the flag, 0 with it.
    "testFrameworkOptions": "--do-not-fail-on-phpunit-warning",
    // Engineering-standard floor (design §8). Raise it as the suite matures; never lower it.
    "minMsi": 70,
    "minCoveredMsi": 70,
    "logs": {
        "text": "php://stderr"
    }
}
